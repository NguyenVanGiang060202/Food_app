POSTGRES_DB=food_app
POSTGRES_USER=food_app
POSTGRES_PASSWORD=change-me-locally

APP_ORIGIN=http://localhost:5173
AUTH_API_ORIGIN=http://localhost:3000
BACKEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432

ADMIN_API_KEY=replace-with-a-local-secret
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Local-only development hints; keep disabled unless explicitly testing without email.
AUTH_EXPOSE_VERIFICATION_LINK=false
AUTH_EXPOSE_RESET_LINK=false

# Brevo Transactional Email API delivery for email verification and password reset.
BREVO_API_KEY=
MAIL_FROM_NAME=HoiBep
MAIL_FROM_EMAIL=noreply@example.com

# SMTP fallback for email verification and password reset.
# Option A: single connection string, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=

# Option B: individual SMTP fields. SMTP_USER/SMTP_PASSWORD may be empty for local SMTP
# tools such as MailHog/Mailpit; production providers usually require them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Food Discovery <mailer@example.com>"

# "Hỏi bếp" runtime intent understanding (LLM). Leave AI_API_KEY empty to use
# the deterministic rule-based interpretation as a fallback.
# The default points at the Gemini OpenAI-compatible endpoint (free tier OK);
# any OpenAI-compatible /chat/completions base URL works (OpenAI, OpenRouter,
# SiliconFlow...).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=15000

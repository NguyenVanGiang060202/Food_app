POSTGRES_DB=food_app
POSTGRES_USER=food_app
POSTGRES_PASSWORD=change-me-locally

APP_ORIGIN=http://localhost:5173
AUTH_API_ORIGIN=http://localhost:3000
BACKEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432

ADMIN_API_KEY=replace-with-a-local-secret
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Local-only development hints; keep disabled unless explicitly testing without email.
AUTH_EXPOSE_VERIFICATION_LINK=false
AUTH_EXPOSE_RESET_LINK=false

# Optional SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
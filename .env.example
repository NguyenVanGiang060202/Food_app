POSTGRES_DB=food_app
POSTGRES_USER=food_app
POSTGRES_PASSWORD=change-me-locally

APP_ORIGIN=http://localhost:5173
AUTH_API_ORIGIN=http://localhost:3000
BACKEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432

ADMIN_API_KEY=replace-with-a-local-secret
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback


AUTH_EXPOSE_VERIFICATION_LINK=false
AUTH_EXPOSE_RESET_LINK=false


BREVO_API_KEY=
MAIL_FROM_NAME=HoiBep
MAIL_FROM_EMAIL=noreply@example.com


SMTP_URL=


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Food Discovery <mailer@example.com>"


AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=15000

# Semantic search embeddings (optional).
# Backend "Hỏi bếp" semantic ranking + crawler `npm run embed:once`.
# Leave EMBEDDING_API_KEY empty to keep the semantic path off (search falls
# back to keyword/structured retrieval). Set the same BASE_URL/API_KEY/MODEL on
# both sides; EMBEDDING_MODEL must match the model used to generate vectors.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
# EMBEDDING_TIMEOUT_MS=15000
# EMBEDDING_CONCURRENCY=4

{
  "name": "@food-discovery/crawler",
  "version": "0.1.0",
  "private": true,
  "description": "Provider adapters and crawler workers for NoN? Platform.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "crawl:fixture": "ts-node --project tsconfig.json src/cli/fixture-crawl.ts",
    "worker:once": "ts-node --project tsconfig.json src/cli/worker.ts",
    "crawl:playwright": "ts-node --project tsconfig.json src/cli/playwright-crawl.ts",
    "crawl:playwright:batch": "ts-node --project tsconfig.json src/cli/playwright-batch-crawl.ts",
    "enrich:once": "ts-node --project tsconfig.json src/cli/enrich.ts",
    "enrich:ai": "ts-node --project tsconfig.json src/cli/enrich-ai.ts",
    "enrich:menu-images": "ts-node --project tsconfig.json src/cli/enrich-menu-images.ts",
    "cache:images": "ts-node --project tsconfig.json src/cli/cache-restaurant-images.ts",
    "refresh:menu": "ts-node --project tsconfig.json src/cli/menu-refresh.ts",
    "quarantine:menu-ocr": "ts-node --project tsconfig.json src/cli/quarantine-menu-ocr.ts",
    "review:menu-images": "ts-node --project tsconfig.json src/cli/export-menu-review.ts",
    "curate:menu-image": "ts-node --project tsconfig.json src/cli/curate-menu-image.ts",
    "curate:reviewed-menu": "ts-node --project tsconfig.json src/cli/apply-reviewed-menu-coverage.ts",
    "curate:selected-menu-dishes": "ts-node --project tsconfig.json src/cli/curate-selected-menu-dishes.ts",
    "ingest:website-menu": "ts-node --project tsconfig.json src/cli/ingest-website-menu.ts",
    "ingest:local-menu": "ts-node --project tsconfig.json src/cli/ingest-local-menu.ts",
    "audit:menu-coverage": "ts-node --project tsconfig.json src/cli/audit-menu-coverage.ts",
    "audit:locations": "ts-node --project tsconfig.json src/cli/audit-location-integrity.ts",
    "coverage:dashboard": "node --env-file=../.env --require ts-node/register src/cli/coverage-dashboard.ts",
    "review:refresh": "ts-node --project tsconfig.json src/cli/review-refresh.ts",
    "embed:once": "ts-node --project tsconfig.json src/cli/embed.ts",
    "check": "npm run typecheck",
    "test": "node --require ts-node/register --test test/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}

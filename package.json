{
  "name": "food-discovery-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Bếp helps people turn cravings into restaurant shortlists.",
  "workspaces": [
    "backend",
    "crawler",
    "frontend"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "ci:local": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File database/scripts/migrate.ps1",
    "context:pack": "repomix --config repomix.config.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "^4.8.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "repomix": "^1.18.0"
  }
}
